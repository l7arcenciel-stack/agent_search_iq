# Files excluded from agent code deployment packaging.
# Uses .gitignore syntax.
# Note: only the root .agentignore is read; subdirectory files are not supported.
#
# To include a file that is excluded by default, use negation: !filename

# azd tooling files
agent.yaml
agent.manifest.yaml
azure.yaml
connection.yaml
connection.yml
toolbox.yaml
toolbox.yml
.agentignore
appPackage.zip
.appPackage.zip.azd-generated
TEAMS_APP_SETUP.md

# Security / secrets
.env
.env.*
.azure/
.git/

# Python
__pycache__/
.venv/
venv/
*.pyc
*.pyo
.mypy_cache/
.pytest_cache/

# .NET
bin/
obj/
*.user
*.suo
.vs/

# Node
node_modules/

# Docker (not used in code deploy)
Dockerfile
.dockerignore

demo_chat.py
requirements-demo.txt
demo_chat_iq.py
demo_chat_simple.py
setup_toolbox.py

# Fabric のノートブック上で実行するコード一式。Fabric 側で動かすものなので
# エージェントのコンテナには不要（pyspark 依存のため、含めると import 解決で問題になりうる）。
fabric_notebooks/

# テナント側の準備（Entra・Fabric アイテム・Foundry ロール）を行うスクリプト。手元で実行するもの。
tenant_setup/

# AI Search への文書投入（手元で1回実行するもの）、手順書・IaC はコンテナに不要
ingest_sample_docs.py
docs/
infra/

# 手元に置かれたインストーラ等（数十MBあり、リモートビルドへのアップロードを重くする）
*.msi
