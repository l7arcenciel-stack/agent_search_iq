AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_API_KEY=<admin-key>
# ★ 元テナントへ反映するときは、既存エージェントとインデックスを共有しないよう
#    新エージェント用に別名のインデックスを作り、ここをその名前にする。
AZURE_SEARCH_INDEX_NAME=poc-documents

AZURE_OPENAI_ENDPOINT=https://<your-aoai-or-foundry-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<api-key>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-10-21

AI_FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
AI_FOUNDRY_MODEL=gpt-4.1-mini

# azd deploy だけが要求する（エージェント本体は読まない）。azd env に入れる。
# AZURE_AI_PROJECT_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>
# FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>

# --- Fabric（Scenario A: Semantic Model経由の構造化データ照会） ---
FABRIC_WORKSPACE_ID=<workspace-guid>
FABRIC_DATASET_ID=<semantic-model-guid>

# OBO未登録（ローカル開発、/obo/register未呼び出し）時のフォールバック値。
# 未設定なら ALL_EMPLOYEES_GROUP_ID が使われる。
CURRENT_USER_GROUPS=<all-employees-group-guid>

# --- ACLグループ（どちらも Entra ID の実グループの Object ID(GUID) を入れる） ---
# ★ ここを文字列スラッグのままにすると、エラーにならずに検索結果が0件になる。
# ★ 値を変えたら AI Search のインデックスを作り直して文書を再投入すること
#    （acl_groups は投入時点のグループIDを文書に焼き付けるため）。
QUALITY_TEAM_GROUP_ID=<quality-team-group-guid>
ALL_EMPLOYEES_GROUP_ID=<all-employees-group-guid>

# Foundry 上のエージェント名（azure.yaml の name / services のキーと一致させる）。
# 元テナントへ反映するときは、既存エージェントと必ず別の名前にする。
IQ_AGENT_NAME=agent-search-iq
# Agent() に渡す表示名。組織名を含めないこと。
AGENT_DISPLAY_NAME=poc-agent-search-iq

# --- OBO（On-Behalf-Of。main.pyの/obo/registerルート、obo.py用） ---
# アプリ登録①（OBO用）の値。テナントごとに作り直す。
# ★ 元テナントへ反映するときは、既存デモが使っているアプリ登録には手を入れず、
#    新エージェント専用のアプリ登録を別に作ること。
OBO_TENANT_ID=<entra-tenant-guid>
OBO_CLIENT_ID=<app-registration-client-id-guid>
OBO_CLIENT_SECRET=<app-registration-client-secret>
OBO_APP_SCOPE=api://<OBO_CLIENT_ID>/.default

# --- Fabric IQ（agent_search_iq で追加） ---
# setup_toolbox.py が出力する Toolbox の MCP エンドポイント（エージェント本体が使う）。
# 未設定でもエージェントは起動する（Fabric IQ 抜きで動く）。
FABRIC_IQ_TOOLBOX_ENDPOINT=

# setup_toolbox.py の実行時にだけ使う（エージェント本体は参照しない）。
# アプリ登録②（Fabric IQ 接続用。①とは別に作る）で作成した Foundry 接続のID。
FABRIC_IQ_PROJECT_CONNECTION_ID=<foundry-fabric-iq-connection-id>
FABRIC_IQ_ONTOLOGY_WORKSPACE_ID=<fabric-workspace-guid>
FABRIC_IQ_ONTOLOGY_ITEM_ID=<ontology-item-guid>
# Toolbox の名前（同名で再実行すると新しいバージョンが作られる）。
FABRIC_IQ_TOOLBOX_NAME=fabric-iq-toolbox

# --- デモUI（demo_chat_iq.py）用 ---
# Foundry を「誰として」呼ぶか。user（既定・推奨）= サインインした本人のトークン /
# operator = このPCで az login しているアカウント（DefaultAzureCredential）。
# operator にすると Fabric IQ はオペレーターの権限で動く（画面に警告が出る）。README 参照。
FOUNDRY_CALL_AS=user
# デモUIが叩くエージェントのエンドポイント（.../agents/<agent>/endpoint まで）。
IQ_AGENT_ENDPOINT_BASE=https://<account>.services.ai.azure.com/api/projects/<project>/agents/agent-search-iq/endpoint
